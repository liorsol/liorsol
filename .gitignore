node_modules/

# Session worktrees the desktop app creates under .claude/. Ignored locally in
# .git/info/exclude too, but that file never leaves this machine -- this line is
# the one a fresh clone gets. Everything else under .claude/ (skills, agents,
# launch.json) is deliberately tracked.
.claude/worktrees/
debug_maps.png
debugReview.mjs
fetchReviews.mjs
fetchGoogleMapsEnriched.mjs
fetchEasy.mjs
rest.json
package.json
package-lock.json
.DS_Store
.wrangler/
**/.wrangler/
.dev.vars
.dev.vars.*

# Tripwire, not a rule. The charging dashboard's proxy holds a credential and is
# deployed from outside this repo; see car-charging/CLAUDE.md. If this line ever
# starts mattering, something has already gone wrong.
car-charging/proxy.js

# impeccable ships a 12MB darwin-arm64 binary and a 1MB font index. Useful locally,
# dead weight in a public repo's permanent history -- and it is the only compiled
# binary any of these skills carries. Reinstall it rather than committing it.
.claude/skills/impeccable/
.agents/skills/impeccable/
